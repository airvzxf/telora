# pacman runs these hooks as root, outside any user session, so
# `systemctl --user` here would reach root's user manager, never the user's.
# The hooks only print the commands each user runs in their own session.

# Older [Install] sections enabled the units under default.target, which
# starts them before the graphical session exists.
_telora_stale_links() {
    getent passwd | while IFS=: read -r _ _ uid _ _ home _; do
        [ "$uid" -ge 1000 ] 2>/dev/null || continue
        for link in "$home"/.config/systemd/user/default.target.wants/telora*.service; do
            [ -L "$link" ] && echo "$link"
        done
    done
}

_telora_report_stale_links() {
    local links units
    links="$(_telora_stale_links)"
    [ -n "$links" ] || return 0
    units="$(echo "$links" | xargs -n1 basename | sort -u | xargs)"
    echo ":: Old enablement links start Telora before the graphical session:"
    echo "$links" | while read -r link; do echo "::     $link"; done
    echo ":: Each affected user should run:"
    echo "::     systemctl --user reenable $units"
}

post_install() {
    # Encourage linger so /run/user/<uid>/telora/ persists across logouts.
    # The hook runs as root, so derive the real user from $SUDO_USER and fall
    # back to id -un for the rare direct-root install.
    local telora_user="${SUDO_USER:-$(id -un)}"
    if ! loginctl show-user "${telora_user}" 2>/dev/null | grep -q 'Linger=yes'; then
        echo ":: Tip: enable linger so telora-daemon survives logout:"
        echo "::      sudo loginctl enable-linger ${telora_user}"
    fi
    echo ":: Telora 0.8.1 has been installed."
    echo ":: IMPORTANT: You need to download a speech model before using Telora."
    echo ":: Please run the following command to download the base model:"
    echo ":: "
    echo "::     telora-models download ggerganov/whisper.cpp/ggml-base.bin"
    echo ":: "
    echo ":: You can also list available models with 'telora-models list'."
    echo ":: To enable socket activation, run:"
    echo "::     systemctl --user enable --now telora-daemon.socket telora.service"
    _telora_report_stale_links
}

post_upgrade() {
    echo ":: Telora has been upgraded. To run the new version, in your session:"
    echo "::     systemctl --user daemon-reload"
    echo "::     systemctl --user restart telora-daemon.service telora.service"
    echo ":: If you changed the model, run 'telora-models download <id>' to refresh weights."
    _telora_report_stale_links
}

pre_remove() {
    echo ":: Before removing Telora, each user should run in their session:"
    echo "::     systemctl --user disable --now telora-daemon.socket telora.service telora-daemon.service"
}
