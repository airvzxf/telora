[Unit]
Description=Telora Assistant UI
After=graphical-session.target telora-daemon.service telora-daemon.socket
Requires=telora-daemon.service
BindsTo=telora-daemon.service
# The daemon socket unit owns %t/telora; wait for that runtime directory.
RequiresMountsFor=%t/telora

[Service]
Type=simple
# The GSK_RENDERER solves the error:
#   vkQueuePresentKHR(): A swapchain no longer matches the surface properties exactly,
#   but can still be used to present to the surface successfully. (VK_SUBOPTIMAL_KHR) (1000001003)
Environment=GSK_RENDERER=gl
Environment=TELORA_DAEMON_SOCKET=%t/telora/daemon.sock
Environment=TELORA_CONTROL_SOCKET=%t/telora/control.sock
# Keep this for manager-level drop-ins; the direct Environment= assignments
# above are what make sibling-service propagation deterministic.
PassEnvironment=TELORA_DAEMON_SOCKET TELORA_CONTROL_SOCKET
ExecStart=/usr/bin/telora-gui
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
