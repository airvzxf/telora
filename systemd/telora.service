[Unit]
Description=Telora Assistant UI
After=graphical-session.target telora-daemon.service
Requires=telora-daemon.service
BindsTo=telora-daemon.service
# Wait until /run/user/<uid>/telora/ is mounted before starting the
# GUI; otherwise the daemon-reload ordering vs GUI-restart races.
RequiresMountsFor=%t/telora

[Service]
Type=simple
# The GSK_RENDERER solves the error:
#   vkQueuePresentKHR(): A swapchain no longer matches the surface properties exactly,
#   but can still be used to present to the surface successfully. (VK_SUBOPTIMAL_KHR) (1000001003)
Environment=GSK_RENDERER=gl
ExecStart=/usr/bin/telora-gui
# Same runtime dir as the daemon so the GUI control socket lives at
# the same /run/user/<uid>/telora/control.sock the daemon's STATUS
# stream can reach.
RuntimeDirectory=telora
RuntimeDirectoryMode=0700
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
