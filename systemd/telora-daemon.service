[Unit]
Description=Telora Audio Daemon (Whisper)
After=network.target pipewire.service telora-daemon.socket
Wants=pipewire.service
Requires=telora-daemon.socket

[Service]
Type=simple
ExecStart=/usr/bin/telora-daemon
Environment=TELORA_DAEMON_SOCKET=%t/telora/daemon.sock
Environment=TELORA_CONTROL_SOCKET=%t/telora/control.sock
# The socket unit owns daemon.sock; RuntimeDirectory and ExecStopPost must
# not remove the systemd-managed inode while the socket unit is active.
# Hardening (light, optional but recommended)
NoNewPrivileges=true
PrivateTmp=true
RestrictAddressFamilies=AF_UNIX
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
