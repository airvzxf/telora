[Unit]
Description=Telora speech-to-text daemon
After=pipewire.service telora-daemon.socket
Wants=pipewire.service
Requires=telora-daemon.socket

[Service]
Type=notify
ExecStart=/usr/bin/telora-daemon
Environment=TELORA_DAEMON_SOCKET=%t/telora/daemon.sock
Environment=TELORA_CONTROL_SOCKET=%t/telora/control.sock
# No RuntimeDirectory= here: it would delete the socket unit's daemon.sock
# every time this service stops or fails to start.
# Hardening (light, optional but recommended)
NoNewPrivileges=true
PrivateTmp=true
# NOTE: `RestrictAddressFamilies=AF_UNIX` was deliberately removed.
# voxora-hf uses `reqwest` to download model weights on first launch, which
# needs AF_INET / AF_INET6. The daemon itself only listens on AF_UNIX.
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target